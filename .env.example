# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# Everything here is for local development. Production values come from the
# deployment environment, not from a file in the repository.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# Generate your own — do not reuse another developer's:
#   .venv/bin/python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me

# True locally. Never True on a deployed server — it exposes tracebacks,
# settings and SQL to anyone who triggers an error.
DJANGO_DEBUG=True

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Where the React dev server runs. Comma separated, no trailing slash.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=asone_logistics
POSTGRES_USER=asone
POSTGRES_PASSWORD=localdevonly
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Email — REQUIRED IN PRODUCTION
# ---------------------------------------------------------------------------
# Sign-in is two-factor: the password buys a one-time code sent by email.
# With no SMTP configured the code goes to the console, which in production
# means **nobody can sign in at all**. Set these before deploying.
#
# Left unset locally, so the code prints in the terminal running the server.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.org
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=AsOne Logistics <no-reply@asone.test>

# How long a sign-in code lasts, and how many wrong tries it allows.
ASONE_LOGIN_CODE_TTL_MINUTES=10
ASONE_LOGIN_CODE_MAX_ATTEMPTS=5

# How long a new member of staff has to accept their invitation. Days, not
# minutes: somebody added on a Friday should still be able to start Monday.
ASONE_INVITATION_TTL_DAYS=7
