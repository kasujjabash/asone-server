# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# Everything here is for local development. Production values come from the
# deployment environment, not from a file in the repository.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# Generate your own — do not reuse another developer's:
#   .venv/bin/python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me

# True locally. Never True on a deployed server — it exposes tracebacks,
# settings and SQL to anyone who triggers an error.
DJANGO_DEBUG=True

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Where the React dev server runs. Comma separated, no trailing slash.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=asone_logistics
POSTGRES_USER=asone
POSTGRES_PASSWORD=localdevonly
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
