{
  // __pycache__ is generated by Python and never edited by hand. Hidden from
  // the explorer and from search so it stops adding noise. It is already in
  // .gitignore, so this is purely about what you see.
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.DS_Store": true
  },
  "search.exclude": {
    "**/__pycache__": true,
    "**/.venv": true
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": false
}
